{
  "name": "smash-rankings",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @sr/db db:generate",
    "db:migrate": "pnpm --filter @sr/db db:migrate",
    "codegen": "pnpm --filter @sr/startgg codegen",
    "e2e": "EXPO_PUBLIC_API_URL=http://localhost:${API_PORT:-8787} pnpm --filter @sr/app build:web --clear && pnpm --filter @sr/e2e e2e",
    "job:discover": "pnpm --filter @sr/jobs discover",
    "job:sync": "pnpm --filter @sr/jobs sync",
    "job:rate": "pnpm --filter @sr/jobs rate",
    "db:seed": "pnpm --filter @sr/db db:seed"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@sr/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
