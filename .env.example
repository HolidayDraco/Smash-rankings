# Copy to .env for local runs. Never commit real values.
STARTGG_TOKEN=
DATABASE_URL=
# Sentry error reports for the API and jobs. Leave blank to turn Sentry off (nothing is sent).
SENTRY_DSN=
# Jobs: Sentry cron check-ins. Blank = sync and rate, 0 = none, or a list like "sync" (free-plan quota).
SENTRY_CRONS=
# API CORS: comma-separated exact origins, e.g. https://app.example.com
ALLOWED_ORIGINS=
# API CORS: optional anchored regex for preview URLs, must start with ^https:// and end with $
ALLOWED_ORIGIN_PATTERN=
# App: public address of the API (like https://api.example.com). Not a secret: it ships in the web page.
EXPO_PUBLIC_API_URL=
# App: Sentry DSN for website crash reports. Not a secret (Sentry DSNs are public). Blank = off.
EXPO_PUBLIC_SENTRY_DSN=
