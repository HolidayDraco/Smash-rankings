# Copy to .env for local runs. Never commit real values.
STARTGG_TOKEN=
DATABASE_URL=
SENTRY_DSN=
# API CORS: comma-separated exact origins, e.g. https://app.example.com
ALLOWED_ORIGINS=
# API CORS: optional anchored regex for preview URLs, must start with ^https:// and end with $
ALLOWED_ORIGIN_PATTERN=
# App: public address of the API (like https://api.example.com). Not a secret: it ships in the web page.
EXPO_PUBLIC_API_URL=
