{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test": {
      // `^test` makes a package's tests wait for its dependencies' tests. That is what keeps the
      // DB suites (which reset the shared TEST_DATABASE_URL) from running at the same time, so any
      // new package using that database must depend on @sr/db or use its own sibling database.
      "dependsOn": ["^test"],
      "env": ["CI", "TEST_DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
