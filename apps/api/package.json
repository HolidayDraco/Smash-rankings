{
  "name": "@sr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/index.js",
    "dev": "tsx watch src/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/node": "11.4.0",
    "@sr/core": "workspace:*",
    "@sr/db": "workspace:*",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.3",
    "@sr/config": "workspace:*",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
